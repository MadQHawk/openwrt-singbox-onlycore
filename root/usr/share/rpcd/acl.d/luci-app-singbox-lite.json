{
  "luci-app-singbox-lite": {
    "description": "Manage sing-box Lite",
    "read": {
      "cgi-io": ["download"],
      "uci": ["singbox-lite"],
      "file": {
        "/etc/sing-box/profiles": ["list"],
        "/etc/sing-box/profiles/*": ["read", "list"],
        "/var/log/sing-box-lite.log": ["read"],
        "/var/log/sing-box-lite-core.log": ["read"]
      },
      "ubus": {
        "file": ["read", "list", "stat"]
      }
    },
    "write": {
      "uci": ["singbox-lite"],
      "file": {
        "/etc/sing-box/profiles": ["write", "remove"],
        "/etc/sing-box/profiles/*": ["write", "remove"],
        "/var/log/sing-box-lite.log": ["write"],
        "/var/log/sing-box-lite-core.log": ["write"],
        "/etc/init.d/singbox-lite": ["exec"]
      },
      "cgi-io": ["upload"],
      "ubus": {
        "file": ["exec", "write", "remove"]
      }
    }
  }
}
