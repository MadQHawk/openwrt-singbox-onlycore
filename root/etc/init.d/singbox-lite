#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

log_event() {
	local message="$1"
	logger -t singbox-lite "$message"
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$message" >>/var/log/sing-box-lite.log
}

boot() {
	local enabled
	config_load singbox-lite
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	start
}

start_service() {
	local config_file start_delay
	config_load singbox-lite
	config_get config_file main config_file ''
	config_get start_delay main start_delay 0
	case "$start_delay" in ''|*[!0-9]*) start_delay=0 ;; esac
	case "$config_file" in
		/etc/sing-box/profiles/*) ;;
		*) log_event 'Invalid or missing profile path'; return 1 ;;
	esac
	[ -f "$config_file" ] || { log_event "Profile not found: $config_file"; return 1; }
	[ -x /usr/bin/sing-box ] || { log_event 'sing-box core not installed at /usr/bin/sing-box'; return 1; }
	[ "$start_delay" -eq 0 ] || sleep "$start_delay"
	if ! /usr/bin/sing-box check -c "$config_file" >>/var/log/sing-box-lite.log 2>&1; then
		log_event 'Configuration check failed; see sing-box output above'
		return 1
	fi
	procd_open_instance
	procd_set_param command /bin/sh -c 'exec /usr/bin/sing-box run -c "$1" >>/var/log/sing-box-lite.log 2>&1' singbox-lite "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger singbox-lite; }
