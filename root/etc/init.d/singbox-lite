#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled config_file start_delay
	config_load singbox-lite
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get config_file main config_file ''
	config_get start_delay main start_delay 0
	case "$start_delay" in ''|*[!0-9]*) start_delay=0 ;; esac
	case "$config_file" in /etc/sing-box/profiles/*) ;; *) logger -t singbox-lite 'Invalid profile path'; return 1 ;; esac
	[ -f "$config_file" ] || { logger -t singbox-lite 'Profile not found'; return 1; }
	[ -x /usr/bin/sing-box ] || { logger -t singbox-lite 'sing-box not installed'; return 1; }
	[ "$start_delay" -eq 0 ] || sleep "$start_delay"
	if ! /usr/bin/sing-box check -c "$config_file" >>/var/log/sing-box-lite.log 2>&1; then
		logger -t singbox-lite 'Configuration check failed'; return 1
	fi
	procd_open_instance
	procd_set_param command /bin/sh -c 'exec /usr/bin/sing-box run -c "$1" >>/var/log/sing-box-lite.log 2>&1' singbox-lite "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger singbox-lite; }
